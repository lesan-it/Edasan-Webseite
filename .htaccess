RewriteEngine On

RewriteCond %{HTTP_HOST} ^www\.edasan\.ch$ [NC]
RewriteRule ^ https://edasan.ch%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} ^edasan\.ch$ [NC]
RewriteCond %{SERVER_PORT} !=443
RewriteRule ^ https://edasan.ch%{REQUEST_URI} [R=301,L]

RewriteRule ^ki/?$ /ki-automatisierung/ [R=301,L]
RewriteRule ^automation/?$ /ki-automatisierung/ [R=301,L]
RewriteRule ^saas/?$ /software/eigenentwicklungen/ [R=301,L]
RewriteRule ^services/it-beratung/?$ /beratung/it-beratung/ [R=301,L]
RewriteRule ^services/it-projekte/?$ /beratung/it-projekte/ [R=301,L]

DirectoryIndex index.html
ErrorDocument 404 /404.html
